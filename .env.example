# Copy to .env and fill in. Never commit the filled version.

# Deployment account. Use a dedicated key, never a funded personal one.
DEPLOYER_PRIVATE_KEY=

# RPC endpoints.
SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Contract constructor args (see README "Deploying with a Safe").
USDC_ADDRESS=           # Arbitrum USDC (mainnet 0xaf88d065e77c8cC2239327C5EDb3A432268e5831)
OWNER_ADDRESS=          # Gnosis Safe address — must be a contract, not an EOA (C4 guard)
ARBITRATOR_ADDRESS=     # dedicated ops wallet (or a second Safe)

